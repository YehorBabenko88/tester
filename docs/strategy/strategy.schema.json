{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YehorBabenko88/tester/docs/strategy/strategy.schema.json",
  "title": "Strategy DSL 1.0 — simulation only",
  "description": "Runtime validate_strategy additionally enforces decimal numeric bounds, nonzero risk/size, leverage/maintenance relationships, expression depth <=16 / nodes <=256, and conditional order offset.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "entry": {
      "type": "object",
      "properties": {
        "long": {
          "$ref": "#/$defs/expression"
        },
        "short": {
          "$ref": "#/$defs/expression"
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    },
    "exit": {
      "$ref": "#/$defs/expression"
    },
    "order": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "market",
            "limit",
            "stop"
          ]
        },
        "latency_bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "offset_bps": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "max_participation": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        }
      },
      "required": [
        "type",
        "latency_bars"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "limit",
                  "stop"
                ]
              }
            }
          },
          "then": {
            "required": [
              "offset_bps"
            ]
          }
        }
      ]
    },
    "risk": {
      "type": "object",
      "properties": {
        "stop_loss": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "take_profit": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "trailing_stop": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "size": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "units",
                "equity_fraction"
              ]
            },
            "value": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            }
          },
          "required": [
            "mode",
            "value"
          ],
          "additionalProperties": false
        },
        "leverage": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "maintenance_margin": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        }
      },
      "required": [
        "stop_loss",
        "take_profit",
        "trailing_stop",
        "size",
        "leverage",
        "maintenance_margin"
      ],
      "additionalProperties": false
    },
    "costs": {
      "type": "object",
      "properties": {
        "fee_rate": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "slippage_bps": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "spread_bps": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "funding_policy": {
          "enum": [
            "required",
            "not_applicable",
            "ignore_exploratory"
          ]
        }
      },
      "required": [
        "fee_rate",
        "slippage_bps",
        "spread_bps",
        "funding_policy"
      ],
      "additionalProperties": false
    },
    "data_policy": {
      "type": "object",
      "properties": {
        "partial": {
          "enum": [
            "reject",
            "exploratory"
          ]
        },
        "gaps": {
          "enum": [
            "reject",
            "continue"
          ]
        }
      },
      "required": [
        "partial",
        "gaps"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "entry",
    "exit",
    "order",
    "risk",
    "costs",
    "data_policy"
  ],
  "additionalProperties": false,
  "$defs": {
    "operand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "enum": [
                "open",
                "high",
                "low",
                "close",
                "volume"
              ]
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "feature": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,99}$"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "feature"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "indicator": {
              "enum": [
                "sma",
                "ema",
                "rsi",
                "vwap"
              ]
            },
            "period": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "field": {
              "enum": [
                "open",
                "high",
                "low",
                "close",
                "volume"
              ]
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "indicator",
            "period"
          ],
          "additionalProperties": false
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "gt",
                "gte",
                "lt",
                "lte",
                "eq",
                "cross_above",
                "cross_below"
              ]
            },
            "left": {
              "$ref": "#/$defs/operand"
            },
            "right": {
              "$ref": "#/$defs/operand"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "pattern"
            },
            "name": {
              "enum": [
                "bullish",
                "bearish",
                "bullish_engulfing",
                "bearish_engulfing",
                "doji"
              ]
            }
          },
          "required": [
            "op",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "session"
            },
            "start_minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1439
            },
            "end_minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "weekdays": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            }
          },
          "required": [
            "op",
            "start_minute",
            "end_minute",
            "weekdays"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
