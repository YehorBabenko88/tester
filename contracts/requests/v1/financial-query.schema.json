{
  "$id": "urn:tester:requests:financial-query:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "instrument_tick_ref": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "price_step_mode": {
            "const": "instrument_tick"
          }
        }
      },
      "then": {
        "properties": {
          "instrument_tick_ref": {
            "type": "string"
          }
        }
      }
    }
  ],
  "description": "Frozen normalized provider input. Availability is supplied independently by storage.",
  "properties": {
    "category": {
      "enum": [
        "linear",
        "inverse",
        "spot"
      ],
      "title": "Category",
      "type": "string"
    },
    "cursor": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cursor"
    },
    "end_ms": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "title": "End Ms",
      "type": "integer"
    },
    "information_cutoff_ms": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Information Cutoff Ms",
      "type": "integer"
    },
    "instrument_tick_ref": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.@/-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Instrument Tick Ref"
    },
    "interval": {
      "pattern": "^[a-zA-Z0-9]{1,12}$",
      "title": "Interval",
      "type": "string"
    },
    "limit": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "price_step": {
      "maxLength": 256,
      "not": {
        "anyOf": [
          {
            "pattern": "^0+(?:\\.0+)?$"
          },
          {
            "pattern": "[^0-9.]"
          }
        ]
      },
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
      "title": "Price Step",
      "type": "string"
    },
    "price_step_mode": {
      "enum": [
        "explicit",
        "instrument_tick"
      ],
      "title": "Price Step Mode",
      "type": "string"
    },
    "query_schema_version": {
      "const": "1.0",
      "title": "Query Schema Version",
      "type": "string"
    },
    "source_interval": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9]{1,12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Interval"
    },
    "start_ms": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Start Ms",
      "type": "integer"
    },
    "symbol": {
      "pattern": "^[A-Z0-9_-]{1,40}$",
      "title": "Symbol",
      "type": "string"
    },
    "venue": {
      "const": "bybit",
      "title": "Venue",
      "type": "string"
    }
  },
  "required": [
    "query_schema_version",
    "venue",
    "category",
    "symbol",
    "start_ms",
    "end_ms",
    "information_cutoff_ms",
    "interval",
    "source_interval",
    "price_step",
    "price_step_mode",
    "instrument_tick_ref",
    "limit",
    "cursor"
  ],
  "title": "FinancialRequest",
  "type": "object"
}
