{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "venue": {
      "const": "bybit"
    },
    "category": {
      "enum": [
        "linear",
        "inverse"
      ]
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9-]{2,50}(?![\\s\\S])"
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provenance"
      }
    },
    "availability": {
      "$ref": "#/$defs/availability"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "end_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "interval": {
      "enum": [
        "1",
        "3",
        "5",
        "15",
        "30",
        "60",
        "120",
        "240",
        "360",
        "720",
        "D",
        "W",
        "M"
      ]
    },
    "kind": {
      "enum": [
        "official_mark",
        "official_index",
        "official_premium"
      ]
    },
    "open": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])"
    },
    "high": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])"
    },
    "low": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])"
    },
    "close": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])"
    },
    "volume": {
      "type": "null"
    },
    "is_closed": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "venue",
    "category",
    "symbol",
    "timestamp_ms",
    "provenance",
    "availability",
    "coverage",
    "start_ms",
    "end_ms",
    "interval",
    "kind",
    "open",
    "high",
    "low",
    "close",
    "is_closed"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YehorBabenko88/tester/contracts/v1_1/price_candle.schema.json",
  "title": "Optional price-only candles v1.1 \u2014 explicit adoption required",
  "description": "Mark/index/premium OHLC have no trade volume. Premium values may be signed. No silent v1.0 endpoint migration.",
  "$defs": {
    "provenance": {
      "type": "object",
      "properties": {
        "source_kind": {
          "enum": [
            "bybit_rest",
            "bybit_archive",
            "synthetic_fixture",
            "derived"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "ingestion_run": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_precision": {
          "enum": [
            "s",
            "ms",
            "us",
            "ns"
          ]
        },
        "source_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "method_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_kind",
        "source_ref",
        "source_hash",
        "ingestion_run",
        "timestamp_precision",
        "source_timestamp"
      ],
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE",
            "PARTIAL",
            "UNAVAILABLE",
            "UNVERIFIED"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "NOT_STARTED",
            "RUNNING",
            "COMPLETE",
            "PARTIAL",
            "GAPS",
            "EMPTY",
            "PROVISIONAL",
            "UNKNOWN",
            "ERROR",
            "UNAVAILABLE"
          ]
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "start_ms",
        "end_ms",
        "evidence_refs"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "official_premium"
          }
        }
      },
      "then": {
        "properties": {
          "category": {
            "const": "linear"
          }
        }
      },
      "else": {
        "properties": {
          "open": {
            "type": "string",
            "pattern": "^(?:0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)(?![\\s\\S])"
          },
          "high": {
            "type": "string",
            "pattern": "^(?:0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)(?![\\s\\S])"
          },
          "low": {
            "type": "string",
            "pattern": "^(?:0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)(?![\\s\\S])"
          },
          "close": {
            "type": "string",
            "pattern": "^(?:0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)(?![\\s\\S])"
          }
        }
      }
    }
  ]
}
